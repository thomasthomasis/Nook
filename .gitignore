# ==========================================
# 3. React Native - iOS Specific
# ==========================================
ios/Pods/
ios/build/
ios/.xcode.env.local
*.xcworkspace/
# Note: Keep the actual xcworkspace if you aren't using CocoaPods, 
# but if you use Pods (standard), ignore the generated workspace:
# !ios/*.xcworkspace 

# Security / Certificates
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

