# ==========================================
android/app/build/
android/.gradle/
android/build/
*.iml
*.apk
*.aar
*.bundle

# Local keystores (Crucial: never commit production signing keys)
*.keystore
*.jks
!debug.keystore

# Android Studio local configurations
local.properties

